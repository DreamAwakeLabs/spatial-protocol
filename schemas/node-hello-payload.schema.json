{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dreamawake.ai/dasp/0.1/node-hello-payload.schema.json",
  "title": "DASP Node Hello Payload",
  "type": "object",
  "required": ["nodeId", "instanceId", "nodeKind", "software", "supportedSpecVersions"],
  "properties": {
    "nodeId": { "$ref": "node-id.schema.json" },
    "instanceId": { "type": "string", "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$" },
    "installationId": { "$ref": "entity-id.schema.json" },
    "nodeKind": { "type": "string", "minLength": 1, "maxLength": 64 },
    "displayName": { "type": "string", "maxLength": 128 },
    "software": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "additionalProperties": false
    },
    "supportedSpecVersions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }
    },
    "extensions": { "type": "object" }
  },
  "additionalProperties": false
}
